{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "npm run compile",
      "options": {
        "cwd": "${workspaceFolder}/vscode-plugin"
      },
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: compile (vscode-plugin)"
    },
    {
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/vscode-plugin"
      },
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "label": "npm: watch (vscode-plugin)"
    }
  ]
}
